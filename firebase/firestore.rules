rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function shopDoc(shopId) {
      return /databases/$(database)/documents/shops/$(shopId);
    }
    function myDevice(shopId) {
      return /databases/$(database)/documents/shops/$(shopId)/devices/$(request.auth.uid);
    }
    // Members = signed-in uids with a non-removed device doc in the shop.
    function isMember(shopId) {
      return request.auth != null
        && exists(myDevice(shopId))
        && get(myDevice(shopId)).data.removed != true;
    }
    // For writes: also true inside the batch that creates the shop together with its first device.
    // Safe because a device doc can only be created with the shop secret (see devices below).
    function isMemberAfter(shopId) {
      return request.auth != null
        && existsAfter(myDevice(shopId))
        && getAfter(myDevice(shopId)).data.removed != true;
    }
    function validSecret() {
      return request.resource.data.joinSecret is string
        && request.resource.data.joinSecret.size() >= 24;
    }

    match /shops/{shopId} {
      allow read: if isMember(shopId);
      allow create: if isMemberAfter(shopId) && validSecret();
      allow update: if isMember(shopId) && validSecret();

      match /devices/{deviceId} {
        allow read: if isMember(shopId);
        // Join: doc id is the caller's uid and the secret matches the shop's current secret.
        allow create: if request.auth != null
          && deviceId == request.auth.uid
          && request.resource.data.removed == false
          && request.resource.data.joinSecret == getAfter(shopDoc(shopId)).data.joinSecret;
        // Rename / remove. All phones are equal; a removed device is not a member, so it can't restore itself.
        allow update: if isMember(shopId);
      }

      match /events/{eventId} {
        allow read: if isMember(shopId);
        allow create: if isMemberAfter(shopId); // append-only audit trail
      }

      match /{sub}/{docId} {
        allow read: if isMember(shopId)
          && sub in ['categories', 'companies', 'medicines', 'batches', 'bills', 'checks'];
        allow write: if isMemberAfter(shopId)
          && sub in ['categories', 'companies', 'medicines', 'batches', 'bills', 'checks'];
      }
    }
  }
}
